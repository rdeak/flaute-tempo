<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's picture, from the Claude Design canvas (board "App icon"): a friendly robot
     over a flute, drawn in a 512 x 512 box. It has no background of its own: the launcher icon
     puts it on @drawable/ic_launcher_background (ic_launcher_foreground insets it into the safe
     zone) and the top bar on a rounded golden square (ui/common/AppLogo.kt). tools/IconGen.java
     draws the same shapes for the PNG icons and the Play listing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- The robot: rotate(-9 about 256,216), then scale 1.1 about 256,196 and down 40, as on the canvas. -->
    <group
        android:pivotX="256"
        android:pivotY="196"
        android:scaleX="1.1"
        android:scaleY="1.1"
        android:translateY="40">
        <group
            android:pivotX="256"
            android:pivotY="216"
            android:rotation="-9">
            <path
                android:strokeColor="#FF2E2A44"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:strokeLineCap="round"
                android:pathData="M256,112 L256,84" />
            <path
                android:fillColor="#FFFF7A6B"
                android:strokeColor="#FF2E2A44"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:pathData="M236,68 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0" />
            <path
                android:fillColor="#FFFF9F68"
                android:strokeColor="#FF2E2A44"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:pathData="M80,216 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />
            <path
                android:fillColor="#FFFF9F68"
                android:strokeColor="#FF2E2A44"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:pathData="M360,216 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0" />
            <path
                android:fillColor="#FFE3EBF3"
                android:strokeColor="#FF2E2A44"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:pathData="M124,216 a132,104 0 1,0 264,0 a132,104 0 1,0 -264,0" />
            <path
                android:fillColor="#FF2E2A44"
                android:pathData="M162,214 a94,64 0 1,0 188,0 a94,64 0 1,0 -188,0" />
            <path
                android:fillColor="#FF7BE8D8"
                android:pathData="M198,200 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />
            <path
                android:fillColor="#FF7BE8D8"
                android:pathData="M278,200 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />
            <path
                android:strokeColor="#FF7BE8D8"
                android:strokeWidth="13"
                android:strokeLineJoin="round"
                android:strokeLineCap="round"
                android:pathData="M224,238 Q256,268 288,238" />
        </group>
    </group>
    <!-- The flute: a white pill with one dot per note letter, C to B, tilted -6 degrees. -->
    <group
        android:translateX="256"
        android:translateY="428"
        android:rotation="-6">
        <path
            android:fillColor="#FFFFFFFF"
            android:strokeColor="#FF2E2A44"
            android:strokeWidth="13"
            android:strokeLineJoin="round"
            android:pathData="M-168,-22 H168 A22,22 0 0 1 168,22 H-168 A22,22 0 0 1 -168,-22 Z" />
        <path
            android:fillColor="#FFFF6B6B"
            android:pathData="M-106,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FFFFA047"
            android:pathData="M-74,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FFFFD93D"
            android:pathData="M-42,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FF7BD67B"
            android:pathData="M-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FF5FD3C8"
            android:pathData="M22,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FFB39DDB"
            android:pathData="M54,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
        <path
            android:fillColor="#FFF7A1C4"
            android:pathData="M86,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
    </group>
</vector>
